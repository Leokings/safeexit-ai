{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "SafeExit Source Signer (Local Development)",
  "version": "0.1.0",
  "description": "Reviews chain-bound EIP-7702 rescue authorizations for SafeExit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeExit Source Signer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://safeexit.xyz/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:4179/*",
        "http://localhost:4179/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://safeexit.xyz/*",
    "https://rpc.xlayer.tech/*",
    "https://xlayerrpc.okx.com/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:4179/*",
    "http://localhost:4179/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src https://rpc.xlayer.tech https://xlayerrpc.okx.com"
  }
}
