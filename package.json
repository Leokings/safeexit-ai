{
  "name": "safeexit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run db:generate && npm run build --workspace @safeexit/web",
    "ci": "npm run db:validate && npm run db:generate && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "npm run dev --workspace @safeexit/web",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "dotenv": "17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.10",
    "prisma": "7.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.17"
  }
}
