# Server-only PostgreSQL connection. Never expose this through NEXT_PUBLIC_*.
DATABASE_URL="postgresql://safeexit:change-me@localhost:5432/safeexit?schema=public"

# Optional direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_URL="postgresql://safeexit:change-me@localhost:5432/safeexit?schema=public"

# Public HTTPS origin used in dashboard links returned by the agent API.
SAFEEXIT_PUBLIC_BASE_URL="http://localhost:3000"

# The agent API is provider-neutral. LIVE_READONLY enables verified X Layer
# discovery, planning, and RPC simulation,
# but still never signs or broadcasts transactions.
SAFEEXIT_AGENT_MODE="DISABLED"
SAFEEXIT_AGENT_STORE="MEMORY"
SAFEEXIT_AI_MODE="DETERMINISTIC"
SAFEEXIT_AI_MODEL=""
# The hosted model can select only a grounded intent and known record IDs.
# These hard limits bound cost and latency; deterministic fallback remains available.
SAFEEXIT_AI_MAX_ESTIMATED_INPUT_TOKENS="12000"
SAFEEXIT_AI_MAX_OUTPUT_TOKENS="256"
SAFEEXIT_AI_TIMEOUT_MS="8000"

# Generate at least 32 random characters. Server-only: never use NEXT_PUBLIC_*.
SAFEEXIT_AGENT_API_KEY="replace-with-a-random-server-only-secret"

# Registered OKX ASP identity allowed to use the normalized A2A bridge.
SAFEEXIT_OKX_PROVIDER_AGENT_ID=""

# Required only for SAFEEXIT_AGENT_MODE=LIVE_READONLY. Create these in the
# official OKX Onchain OS developer portal. Keep all three server-only.
OKX_WEB3_API_KEY=""
OKX_WEB3_SECRET_KEY=""
OKX_WEB3_PASSPHRASE=""

# Paid deterministic API service. Payment settles on X Layer mainnet through
# the official OKX x402 facilitator. This address receives the 0.1 USDT fee.
SAFEEXIT_X402_MODE="DISABLED"
SAFEEXIT_X402_PAY_TO_ADDRESS=""

# Dedicated provider URLs, including QuickNode endpoints. These remain server-only.
# Additional chains are configuration-only until their rescue adapters are verified.
ETHEREUM_MAINNET_RPC_URL=""
BNB_MAINNET_RPC_URL=""
POLYGON_MAINNET_RPC_URL=""
ARBITRUM_MAINNET_RPC_URL=""
OPTIMISM_MAINNET_RPC_URL=""
BASE_MAINNET_RPC_URL=""
AVALANCHE_MAINNET_RPC_URL=""
XLAYER_MAINNET_RPC_URL=""
# Legacy alias accepted for X Layer (OKX): OKX_XLAYER_MAINNET_RPC_URL

SAFEEXIT_RATE_LIMIT_MAX_REQUESTS=20
SAFEEXIT_RATE_LIMIT_WINDOW_MS=60000
